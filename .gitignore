# =============================================================================
#  企业级 .gitignore
#
#  原则：凡是「可能含敏感内容」的一律不入库；需要入库的写成明确例外。
#  新增目录或文件类型前先问一句 —— 它的内容会不会回显内部资料？
#
#  ⚠️  .gitignore 只拦「尚未追踪」的文件。已经被 git add 过的文件，规则不生效，
#      必须先 `git rm --cached <file>` 解除追踪。见文件末尾的补救清单。
#
#  分层（越靠前越致命）：
#    1. 凭据与秘密        —— 一次泄露即作废，只能轮换，删文件没用
#    2. 业务数据与派生数据 —— 内部文档、明文 key、索引里回显的原文
#    3. 个人与机器痕迹    —— IDE、OS、绝对路径、本地运行配置
#    4. 构建产物与依赖
#    5. 日志与临时文件    —— 日志里常出现请求体，即用户问题和文档片段
# =============================================================================


# =============================================================================
# 1. 凭据与秘密
#    命中即视为已泄露：revoke + 重新签发，不要靠删文件或改 .gitignore 解决。
# =============================================================================

# 环境变量文件（.env.example 是无害模板，明确放行）
.env
.env.*
*.env
!.env.example

# 私钥与证书
*.pem
*.key
*.p8
*.p12
*.pfx
*.der
*.crt
*.csr
*.p7b
*.jks
*.keystore
*.ppk
*.mobileprovision

# SSH 密钥（公钥 .pub 是公开的，不忽略）
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# 云服务与包管理器凭据
serviceAccount*.json
service-account*.json
*credentials*.json
.gcloud/
.aws/
.azure/
.npmrc              # 常含 //registry/:_authToken=，不入库；团队用私有源时另行分发
.pypirc
.netrc
.netrc.gpg
.pgpass
.htpasswd

# 兜底：按命名猜敏感文件。本项目没有这类文件，纯粹是安全网。
# 代价是可能误伤 —— 真要入库时用 `git add -f <file>` 明确放行并注明原因。
*secret*
*secrets*
*credential*
*token*
!tokenizer.json
!tokenizer_config.json


# =============================================================================
# 2. 业务数据与派生数据
#    这一层才是本项目真正的隐私边界。内容一旦进了版本库，就再也回不来了。
# =============================================================================

# 内部规范文档（企业标准、学籍/人事资料等）—— 隐私内容的源头，绝不入库。
# 这些文件应通过内网文档系统或加密渠道分发，不走 git。
knowledgeFile/

# server/data/ 存着本项目全部运行时数据，里面有三类不该入库的东西：
#   data/settings.json  前端「模型设置」保存的 API Key **明文**
#   data/lancedb/       向量索引 —— 每一行的 text 列就是内部文档正文
#   data/hf-cache/      嵌入模型缓存，259MB 二进制
server/data/

# 双保险：就算有人把运行时配置挪到别处，也不允许按这个名字入库
settings.json
!settings.example.json
!**/settings.example.json

# 上传落盘区（当前 multer 用内存缓冲，尚无此目录；将来改成落盘时自动生效）
server/uploads/
server/tmp/
server/data/uploads/

# 兜底：本项目只「读取」文档，仓库里永远不需要提交任何 Office 文档。
# 真要提交模板文档时，用 `git add -f` 放行并在此注明。
*.docx
*.docm
*.doc
*.xlsx
*.xlsm
*.xls
*.ppt
*.pptx
*.pst
*.ost
*.nsf

# 例外：仓库自带的脱敏样例文档，供外部用户跑通 ingest / eval
!examples/*.docx

# docs/ 下的汇报幻灯片属于本地产出物，不入库（已被上面的 *.pptx / *.pdf 规则拦下）。


# =============================================================================
# 3. 个人与机器痕迹
#    含绝对路径、本地运行配置，会污染 diff；IDE 的 run configuration 还可能
#    悄悄存下环境变量和命令行参数。
# =============================================================================

# JetBrains
.idea/
*.iml
*.ipr
*.iws

# VS Code —— 只共享扩展推荐，settings/launch 里常有本地路径和 env
.vscode/*
!.vscode/extensions.json
!.vscode/*.code-snippets

# Vim / Emacs / Eclipse / NetBeans
*.swp
*.swo
*~
.project
.classpath
.settings/
nbproject/
.tern-project

# 操作系统
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/


# =============================================================================
# 4. 构建产物与依赖
# =============================================================================
node_modules/
dist/
build/
out/
.vite/
.turbo/
.cache/
*.tsbuildinfo
coverage/
.nyc_output/


# =============================================================================
# 5. 日志与临时文件
#    日志里常出现完整请求体 —— 也就是用户的问题和检索到的文档片段。
# =============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.pid
*.pid.lock
*.seed
*.tmp
*.temp
*.bak
*.sw?
~$*


# =============================================================================
# 6. 本项目用到的工具目录
# =============================================================================
.gstack/
.claude/settings.local.json
.workbuddy/


# =============================================================================
# 补救清单
# =============================================================================
# .gitignore 只拦「尚未追踪」的文件。若某个敏感文件已经被追踪，必须先解除追踪：
#   git rm --cached <file>
# 已经推送过的敏感内容无法靠删除文件挽回：密钥必须轮换，文档需要重写历史并通知协作者。
# 本公开分支采用无历史的初始提交，因此不包含早期提交中的任何产出物。
