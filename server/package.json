{
  "name": "rag-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "LangChain RAG backend: docx ingestion, local embeddings, LanceDB, Claude answers",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "ingest": "tsx src/cli-ingest.ts",
    "eval": "tsx src/eval.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@huggingface/transformers": "3.8.1",
    "@lancedb/lancedb": "0.19.1",
    "@langchain/anthropic": "^1.6.5",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.4.1",
    "@langchain/openai": "^1.8.4",
    "@langchain/textsplitters": "^1.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
