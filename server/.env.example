# Copy to server/.env and adjust as needed. Every value below has a working default.

# --- HTTP ---
PORT=3001

# --- Retrieval ---
# How many chunks to pull back for each question.
TOP_K=8
# Chunking, in characters. Keep this comfortably under the embedding model's
# 512-token limit — for Chinese, ~1 char per token, so 250 is a safe ceiling.
# Smaller chunks are also more topically uniform, which stops a long generic
# passage (a document's preface) from outscoring the section that answers the
# question. Rebuild the index after changing this: npm run ingest
CHUNK_SIZE=250
CHUNK_OVERLAP=50
# Prepend "《文档名》 · 小节标题" to every chunk before embedding, so a chunk
# knows which document and section it came from. Measured on one failure case it
# removed an unrelated document from the results and moved on-topic chunks in
# the top 8 from 2 to 5. Set to false to turn it off (requires a rebuild).
CHUNK_CONTEXT_PREFIX=true

# --- Embeddings (runs locally, no API key) ---
# Retrieval-trained and multilingual (Chinese + English). Requires the query /
# passage prefixes below; clear them if you switch to a model that wants none,
# e.g. EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2 with both
# prefixes set to an empty string.
EMBEDDING_MODEL=Xenova/multilingual-e5-small
# Quoted on purpose — the trailing space is part of the prefix and an unquoted
# value would lose it, which silently wrecks every score.
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_PASSAGE_PREFIX="passage: "
# A mirror is used by default; set HF_ENDPOINT=https://huggingface.co if you
# have direct access to huggingface.co.
HF_ENDPOINT=https://hf-mirror.com

# --- Answer generation ---
# "anthropic" (Claude) or "openai" (any OpenAI-compatible endpoint).
# Only this half of the app needs a key — ingest, embeddings and vector search
# are all local and run fine with no credentials at all.
#
# These LLM settings can also be changed from the sidebar's 模型设置 panel; the
# panel writes server/data/settings.json and applies it immediately, so values
# set there take precedence over anything below.
LLM_PROVIDER=anthropic

# --- anthropic: pick ONE of the two ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_AUTH_TOKEN=...            # OAuth / proxy token instead of an API key
# ANTHROPIC_BASE_URL=http://127.0.0.1:15721   # only if you route through a proxy

# --- openai: works with DeepSeek / 通义千问 / 智谱 GLM / Ollama / vLLM ---
# LLM_PROVIDER=openai
# LLM_MODEL=deepseek-chat            # provider-specific; default is gpt-4o-mini
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.deepseek.com/v1   # omit for api.openai.com
# Local endpoints (Ollama/vLLM) don't check the key — any placeholder works:
# OPENAI_API_KEY=ollama

# With no credentials for the selected provider the server still runs the whole
# retrieval pipeline and returns raw chunks, labelled "未调用模型" in the UI.

# ⚠️ dotenv does NOT override variables already present in the shell, so a
# value written here is ignored if the same variable is already exported in
# your terminal. Use a fresh terminal, or set the variable at the OS level.

